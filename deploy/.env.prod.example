# Ticket 049 — plantilla de deploy/.env.prod (real, con valores reales,
# vive SOLO en la VM, gitignored). Copiar este archivo a deploy/.env.prod
# en la VM y llenar los valores REALES antes del primer deploy a PROD.
#
# A diferencia de deploy/.env.test.example, estos valores sí importan para
# tráfico real — no se recomienda dejar RESEND_API_KEY/TWILIO_*/VAULT_*
# vacíos en producción salvo que se acepte explícitamente que esos flujos
# fallarán ruidosamente (por diseño, no en silencio) hasta configurarse.

# Imagen a promover — la asigna el workflow (SHA ya validado en TEST), no a
# mano.
IMAGE_TAG=

DB_PASSWORD=cambiar-por-una-contrasena-real-de-produccion

APP_BASE_URL=https://auth.64bitstudio.com

RESEND_API_KEY=
RESEND_FROM_ADDRESS=noreply@example.com

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Vault Transit: ver docs/ARQUITECTURA.md ticket 049 — pendiente de decidir
# cómo esta VM alcanza una instancia de Vault real para PROD.
VAULT_ADDR=
VAULT_ROOT_TOKEN=
VAULT_TRANSIT_KEY_NAME=auth-core-mc-tenant-keys

BREAKGLASS_SECRET=
BREAKGLASS_TOTP_SECRET=
BREAKGLASS_ALLOWED_IPS=

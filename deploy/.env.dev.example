# Ticket 049 (rediseño dev/qa/prod) — plantilla de deploy/.env.dev (real,
# con valores reales, vive SOLO en la VM, gitignored). Copiar este archivo
# a deploy/.env.dev en la VM y llenar los valores. Antes se llamaba
# deploy/.env.test — mismo propósito, renombrado junto con el stack.
#
# DB_PASSWORD es el único valor estrictamente obligatorio para que el
# stack arranque (ver docker-compose.dev.yml: sin él, Compose se niega a
# levantar el servicio con un mensaje explícito). El resto son integraciones
# externas opcionales para el ambiente de desarrollo — pueden quedar vacías
# mientras no se ejerciten esos flujos (mismo comportamiento "vacío por
# defecto" que backend/.env.example en local).

# Imagen a desplegar — la asigna el workflow (SHA del commit), no a mano.
IMAGE_TAG=

DB_PASSWORD=cambiar-por-una-contrasena-real-de-dev

APP_BASE_URL=https://auth-dev.64bitstudio.com

RESEND_API_KEY=
RESEND_FROM_ADDRESS=noreply@example.com

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Vault Transit: ticket platform/005 -- resuelto. VAULT_ADDR apunta al
# Vault compartido de la VM (alcanzable por nombre de contenedor dentro
# de la red "vm-infra", ver deploy/docker-compose.dev.yml). VAULT_SECRET_ID
# lo renderiza corePipeline.groovy en cada deploy, leído de
# secret/auth-core-mc/dev en Vault (mismo mecanismo que DB_PASSWORD) --
# déjalo vacío aquí, nunca a mano. VAULT_ROOT_TOKEN ya no se usa en este
# ambiente (solo en el Vault local de dev-infra, ver
# VaultTransitEncryptor.java).
VAULT_ADDR=http://vault:8200
VAULT_SECRET_ID=
VAULT_ROOT_TOKEN=
VAULT_TRANSIT_KEY_NAME=auth-core-mc-tenant-keys

BREAKGLASS_SECRET=
BREAKGLASS_TOTP_SECRET=
BREAKGLASS_ALLOWED_IPS=

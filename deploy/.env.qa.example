# Ticket 049 (rediseño dev/qa/prod) — plantilla de deploy/.env.qa (real,
# con valores reales, vive SOLO en la VM, gitignored). Copiar este archivo
# a deploy/.env.qa en la VM y llenar los valores.
#
# DB_PASSWORD es el único valor estrictamente obligatorio para que el
# stack arranque (ver docker-compose.qa.yml). El resto son integraciones
# externas opcionales — pueden quedar vacías mientras no se ejerciten esos
# flujos.

# Imagen a promover — la asigna el workflow (SHA ya validado en DEV), no a
# mano.
IMAGE_TAG=

DB_PASSWORD=cambiar-por-una-contrasena-real-de-qa

APP_BASE_URL=https://auth-qa.64bitstudio.com

RESEND_API_KEY=
RESEND_FROM_ADDRESS=noreply@example.com

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Vault Transit: ver docs/ARQUITECTURA.md ticket 049 — pendiente de decidir
# cómo DEV/QA/PROD en la VM alcanzan una instancia de Vault (hoy Vault solo
# corre en ~/dev-infra, en la Mac). Vacío = TenantIdentityProviderService
# fallará ruidosamente si algún tenant intenta configurar un secreto social.
VAULT_ADDR=
VAULT_ROOT_TOKEN=
VAULT_TRANSIT_KEY_NAME=auth-core-mc-tenant-keys

BREAKGLASS_SECRET=
BREAKGLASS_TOTP_SECRET=
BREAKGLASS_ALLOWED_IPS=

# Ticket 049 — plantilla de deploy/.env.test (real, con valores reales,
# vive SOLO en la VM, gitignored). Copiar este archivo a deploy/.env.test
# en la VM y llenar los valores.
#
# DB_PASSWORD es el único valor estrictamente obligatorio para que el
# stack arranque (ver docker-compose.test.yml: sin él, Compose se niega a
# levantar el servicio con un mensaje explícito). El resto son integraciones
# externas opcionales para el ambiente de pruebas — pueden quedar vacías
# mientras no se ejerciten esos flujos (mismo comportamiento "vacío por
# defecto" que backend/.env.example en local).

# Imagen a desplegar — la asigna el workflow (SHA del commit), no a mano.
IMAGE_TAG=

DB_PASSWORD=cambiar-por-una-contrasena-real-de-test

APP_BASE_URL=http://159.54.153.37:8081

RESEND_API_KEY=
RESEND_FROM_ADDRESS=noreply@example.com

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Vault Transit: ver docs/ARQUITECTURA.md ticket 049 — pendiente de decidir
# cómo TEST/PROD en la VM alcanzan una instancia de Vault (hoy Vault solo
# corre en ~/dev-infra, en la Mac). Vacío = TenantIdentityProviderService
# fallará ruidosamente si algún tenant intenta configurar un secreto social.
VAULT_ADDR=
VAULT_ROOT_TOKEN=
VAULT_TRANSIT_KEY_NAME=auth-core-mc-tenant-keys

BREAKGLASS_SECRET=
BREAKGLASS_TOTP_SECRET=
BREAKGLASS_ALLOWED_IPS=

# Copia este archivo a ".env" (mismo directorio) y completa los valores reales.
# .env NUNCA se sube a git (ver .gitignore).

# --- Resend (correo transaccional) ---
RESEND_API_KEY=
RESEND_FROM_ADDRESS=noreply@example.com

# --- Twilio (SMS) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Google Sign-In (ticket 006) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Facebook Login (ticket 006) ---
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# --- App ---
APP_BASE_URL=http://localhost:8080
# Genera la tuya con: openssl rand -base64 32 (NUNCA uses el default de application.properties en producción)
APP_SECRET_ENCRYPTION_KEY=

# --- Vault Transit (cifrado por sobres de secretos de tenant, ticket 017) ---
# Ticket auth-core-mc/051: desarrollo local usa la Vault de la VM (ya no
# un Vault local en tu Mac) vía la AppRole "auth-core-mc-local-dev" --
# credencial propia, revocable sin afectar a DEV/QA/PROD. VAULT_ADDR y
# VAULT_ROLE_ID ya tienen default correcto en application.properties (no
# son secreto) -- solo hace falta VAULT_SECRET_ID, que SÍ es secreto y no
# tiene default. Pídele a quien administre Vault que te genere uno nuevo
# con:
#   ssh ampere-free 'bash -s' < platform/deploy/vm-infra/vault/bootstrap-auth-core-mc-local-dev-approle.sh
# (genera una AppRole nueva si no existe, o puedes pedir un SecretID
# adicional para la misma si ya existe).
VAULT_SECRET_ID=
